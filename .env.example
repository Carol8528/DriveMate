# One-click startup generates both runtime tokens automatically.
DRIVEMATE_API_MODE=http
DRIVEMATE_BACKEND_URL=http://127.0.0.1:8000
DRIVEMATE_API_TOKEN=runtime_generated_token
DRIVEMATE_API_TIMEOUT_SECONDS=60

DRIVEMATE_SIMULATOR_URL=http://127.0.0.1:8765
DRIVEMATE_SIMULATOR_TOKEN=runtime_generated_token

# Container deployment. The Dockerfile configures these values automatically.
# DRIVEMATE_FRONTEND_URL=http://127.0.0.1:7860
# DRIVEMATE_FRONTEND_HOST=0.0.0.0
# DRIVEMATE_SKIP_FRONTEND_BUILD=1
# DRIVEMATE_NO_BROWSER=1

# Optional SQLite locations.
DRIVEMATE_AUDIT_DB=./data/audit.db
DRIVEMATE_SIMULATOR_DB=./data/simulator_state.db

# Optional external semantic LLM.
# Only API_KEY is required with the default DashScope OpenAI-compatible endpoint.
API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30

# Optional CRM handoff.
CRM_API_ENDPOINT=
CRM_API_KEY=
