{
  "name": "play_media",
  "domain": "vehicle_comfort",
  "description": "音乐/白噪音/儿童内容播放",
  "safety_level": "L1",
  "idempotent": false,
  "requires_confirmation": false,
  "parameters": {
    "type": "object",
    "properties": {
      "genre": {
        "type": "string",
        "enum": ["music", "white_noise", "children", "podcast", "news"],
        "description": "内容类型"
      },
      "source": {
        "type": "string",
        "description": "具体内容标识（歌曲名/歌单/频道）"
      },
      "volume": {
        "type": "integer",
        "description": "音量（0-100，可选）",
        "minimum": 0,
        "maximum": 100
      },
      "loop": {
        "type": "boolean",
        "description": "是否循环播放（可选）",
        "default": false
      }
    },
    "required": ["genre", "source"]
  }
}
